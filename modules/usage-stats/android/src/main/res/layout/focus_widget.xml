<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/focus_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/focus_widget_bg"
  android:gravity="center_vertical"
  android:orientation="vertical"
  android:padding="14dp">

  <TextView
    android:id="@+id/focus_widget_main"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="FocusMonster"
    android:textColor="#F2EFEA"
    android:textSize="20sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/focus_widget_sub"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Open the app to start"
    android:textColor="#A8A298"
    android:textSize="13sp" />
</LinearLayout>
