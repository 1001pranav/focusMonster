<?xml version="1.0" encoding="utf-8"?>
<!--
  Window changes everywhere, to know which app opened. Window content is retrieved only inside
  Instagram and YouTube, and only to find the Reels/Shorts player by its view id: the service adds
  scroll and content events at runtime while one of those apps is open (FocusAccessibilityService).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
  android:accessibilityEventTypes="typeWindowStateChanged"
  android:accessibilityFeedbackType="feedbackGeneric"
  android:accessibilityFlags="flagReportViewIds"
  android:canRetrieveWindowContent="true"
  android:notificationTimeout="100"
  android:description="@string/focus_service_description" />
